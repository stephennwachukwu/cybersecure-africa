# Database Configuration
DB_PASSWORD=your_secure_database_password_here

# SMTP Configuration (for email confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
FROM_EMAIL=noreply@cybersecureafrica.org

# Application URLs
BASE_URL=https://cybersecureafrica.org
VITE_API_URL=https://cybersecureafrica.org/api

# CORS Configuration
ALLOWED_ORIGINS=https://cybersecureafrica.org,https://www.cybersecureafrica.org

# Domain for SSL
DOMAIN=cybersecureafrica.org
EMAIL=admin@cybersecureafrica.org
